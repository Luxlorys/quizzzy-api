generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuestionKind {
  single
  multi
}

enum AttemptStatus {
  draft
  submitted
}

model Article {
  id        Int      @id @default(autoincrement())
  filename  String
  sourceKey String   @map("source_key")
  createdAt DateTime @default(now()) @map("created_at")

  quizzes Quiz[]

  @@map("articles")
}

model Quiz {
  id         Int      @id @default(autoincrement())
  articleId  Int      @map("article_id")
  title      String
  topic      String
  sourceName String   @map("source_name")
  createdAt  DateTime @default(now()) @map("created_at")

  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  Attempt[]

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([title, id])
  @@map("quizzes")
}

model Question {
  id          Int          @id @default(autoincrement())
  quizId      Int          @map("quiz_id")
  position    Int
  kind        QuestionKind
  prompt      String
  explanation String

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options Option[]

  @@unique([quizId, position])
  @@map("questions")
}

model Option {
  id         Int     @id @default(autoincrement())
  questionId Int     @map("question_id")
  text       String
  isCorrect  Boolean @map("is_correct")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, id])
  @@map("options")
}

model Attempt {
  id           Int           @id @default(autoincrement())
  quizId       Int           @map("quiz_id")
  status       AttemptStatus @default(draft)
  currentIndex Int           @default(0) @map("current_index")
  score        Int?
  total        Int?
  startedAt    DateTime      @map("started_at")
  submittedAt  DateTime?     @map("submitted_at")

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@index([quizId, id(sort: Desc)])
  @@map("attempts")
}

model AttemptAnswer {
  id                Int   @id @default(autoincrement())
  attemptId         Int   @map("attempt_id")
  questionId        Int   @map("question_id")
  selectedOptionIds Int[] @map("selected_option_ids")

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}
