generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuestionKind {
  single
  multi
}

enum AttemptStatus {
  draft
  submitted
}

enum GenerationStatus {
  pending
  running
  succeeded
  failed
}

model Article {
  id        Int      @id @default(autoincrement())
  filename  String
  sourceKey String   @map("source_key")
  createdAt DateTime @default(now()) @map("created_at")

  quizzes     Quiz[]
  generations QuizGeneration[]

  @@map("articles")
}

model Quiz {
  id         Int      @id @default(autoincrement())
  articleId  Int      @map("article_id")
  title      String
  topic      String
  sourceName String   @map("source_name")
  createdAt  DateTime @default(now()) @map("created_at")

  article     Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  questions   Question[]
  attempts    Attempt[]
  generations QuizGeneration[]

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([title, id])
  @@map("quizzes")
}

model QuizGeneration {
  id              Int              @id @default(autoincrement())
  articleId       Int              @map("article_id")
  status          GenerationStatus @default(pending)
  lockToken       String           @map("lock_token")
  quizId          Int?             @map("quiz_id")
  failureCode     String?          @map("failure_code")
  failureMessage  String?          @map("failure_message")
  inputTokens     Int?             @map("input_tokens")
  outputTokens    Int?             @map("output_tokens")
  cacheReadTokens Int?             @map("cache_read_tokens")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  finishedAt      DateTime?        @map("finished_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  quiz    Quiz?   @relation(fields: [quizId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("quiz_generations")
}

model Question {
  id          Int          @id @default(autoincrement())
  quizId      Int          @map("quiz_id")
  position    Int
  kind        QuestionKind
  prompt      String
  explanation String

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options Option[]

  @@unique([quizId, position])
  @@map("questions")
}

model Option {
  id         Int     @id @default(autoincrement())
  questionId Int     @map("question_id")
  text       String
  isCorrect  Boolean @map("is_correct")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, id])
  @@map("options")
}

model Attempt {
  id           Int           @id @default(autoincrement())
  quizId       Int           @map("quiz_id")
  status       AttemptStatus @default(draft)
  currentIndex Int           @default(0) @map("current_index")
  score        Int?
  total        Int?
  startedAt    DateTime      @map("started_at")
  submittedAt  DateTime?     @map("submitted_at")

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@index([quizId, id(sort: Desc)])
  @@map("attempts")
}

model AttemptAnswer {
  id                Int   @id @default(autoincrement())
  attemptId         Int   @map("attempt_id")
  questionId        Int   @map("question_id")
  selectedOptionIds Int[] @map("selected_option_ids")

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}
