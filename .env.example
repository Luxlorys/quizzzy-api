# Copy to .env for local development. Every variable is validated at startup
# by src/config.ts — the app refuses to boot with a bad configuration.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# `docker compose up -d postgres` provides this database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# `docker compose up -d redis` provides this. Used for read-through caching of
# entities by id (see modules/quiz). A Redis outage degrades to database reads;
# it does not fail requests.
REDIS_URL=redis://localhost:6379

# Optional: how long a cached entity stays readable, in seconds (default 60).
# CACHE_TTL_SECONDS=60

# Optional: protect /docs with basic auth (username "docs").
# DOCS_PASSWORD=

# Optional: requests per minute per client (default 100).
# RATE_LIMIT_MAX=100

# Where submitted article HTML is written, relative to the working directory.
# A v2 swaps this module's storage port for an S3 implementation.
# ARTICLE_STORAGE_DIR=storage/articles
