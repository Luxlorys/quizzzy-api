# Copy to .env for local development. Every variable is validated at startup
# by src/config.ts — the app refuses to boot with a bad configuration.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# `docker compose up -d postgres` provides this database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# `docker compose up -d redis` provides this. Required at boot — the app
# refuses to start without it, since the generation lock (see modules/generation)
# has nowhere else to live. Once connected, a later Redis outage still degrades
# quiz caching (see modules/quiz) to database reads; it does not fail requests.
REDIS_URL=redis://localhost:6379

# Optional: how long a cached entity stays readable, in seconds (default 60).
# CACHE_TTL_SECONDS=60

# Optional: protect /docs with basic auth (username "docs").
# DOCS_PASSWORD=

# Optional: requests per minute per client (default 100).
# RATE_LIMIT_MAX=100

# Where submitted article HTML is written, relative to the working directory.
# A v2 swaps this module's storage port for an S3 implementation.
# ARTICLE_STORAGE_DIR=storage/articles

# Required — no default. Quiz generation (see modules/generation) refuses to
# start without it.
ANTHROPIC_API_KEY=

# Optional: the model used for quiz generation (default claude-sonnet-5).
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: SDK transport retries for 429/5xx/timeouts (default 3).
# ANTHROPIC_MAX_RETRIES=3

# Optional: request timeout for a single generation call, in milliseconds
# (default 600000, i.e. 10 minutes).
# ANTHROPIC_REQUEST_TIMEOUT_MS=600000

# Optional: reasoning effort for quiz generation (default high).
# GENERATION_EFFORT=high

# Optional: hard cap on input tokens per generation; over this the article is
# rejected before any billable call (default 150000).
# GENERATION_MAX_INPUT_TOKENS=150000

# Optional: max output tokens for a single generation call (default 32000).
# The ceiling has to cover a 30-question quiz plus adaptive thinking.
# GENERATION_MAX_OUTPUT_TOKENS=32000

# Optional: the bounds on how many questions a generated quiz may have
# (defaults 5 and 30). The count itself is not fixed — it is derived per
# article from how much readable text it has and then chosen by the model
# inside that range, so a long article can earn 30 questions and a short one
# stays near the floor. These two only cap the ends.
# GENERATION_MIN_QUESTIONS=5
# GENERATION_MAX_QUESTIONS=30

# Optional: how many times an invalid quiz is sent back to the model for
# correction before the generation fails (default 1). Every correction is one
# more billable call.
# GENERATION_MAX_CORRECTIONS=1

# Optional: the Redis lock's TTL in seconds (default 90). Must be at least
# twice GENERATION_LOCK_RENEW_SECONDS.
# GENERATION_LOCK_TTL_SECONDS=90

# Optional: how often the lock is renewed while a generation runs, in seconds
# (default 30).
# GENERATION_LOCK_RENEW_SECONDS=30
